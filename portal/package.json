{
  "name": "ssportal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"node --watch server/index.mjs\" \"vite\"",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:stack": "node --test tests/stack.integration.mjs",
    "test:e2e": "npm run check && vite build && playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "@fontsource-variable/manrope": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "fastify": "^5.2.1",
    "lucide-preact": "^0.468.0",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@preact/preset-vite": "^2.10.1",
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2",
    "vite": "^7.3.1"
  }
}
